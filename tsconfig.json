{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "useDefineForClassFields": true,
        "noEmit": true,
        "types": []
    },
    "include": ["./src/**/*.ts", "./types/*.d.ts"]
}
